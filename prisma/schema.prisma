generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ConversationMessageRole {
  USER
  ASSISTANT
}

enum MemoryScope {
  USER
  GROUP
}

enum MemoryType {
  FACT
  PREFERENCE
  RELATIONSHIP
  PROJECT
  EVENT
  OTHER
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum MemoryAuditAction {
  FORGET
  CLEAR
  DISABLE
  ENABLE
}

model DiscordUser {
  id String @id @default(cuid())

  discordUserId String  @unique @map("discord_user_id")
  username      String?
  displayName   String  @map("display_name")

  firstSeenAt DateTime @map("first_seen_at")
  lastSeenAt  DateTime @map("last_seen_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  memoryEnabled Boolean  @default(true) @map("memory_enabled")

  messages        ConversationMessage[]
  subjectMemories Memory[]              @relation("MemorySubject")
  memoryAudits    MemoryAudit[]

  @@map("discord_users")
}

model ConversationMessage {
  id String @id @default(cuid())

  discordMessageId String @unique @map("discord_message_id")

  guildId   String @map("guild_id")
  channelId String @map("channel_id")

  authorId   String      @map("author_id")
  authorName String      @map("author_name")
  author     DiscordUser @relation(fields: [authorId], references: [discordUserId], onDelete: Restrict, onUpdate: Cascade)

  role    ConversationMessageRole
  content String                  @db.Text

  discordCreatedAt DateTime @map("discord_created_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sourceMemories Memory[]         @relation("MemorySource")
  memoryEvidence MemoryEvidence[]

  @@index([authorId])
  @@index([guildId, channelId, discordCreatedAt])
  @@map("conversation_messages")
}

model Memory {
  id String @id @default(cuid())

  scope MemoryScope
  type  MemoryType

  content           String  @db.Text
  normalizedContent String  @map("normalized_content") @db.Text
  embedding         Float[] @default([])

  subjectUserId String?      @map("subject_user_id")
  subjectUser   DiscordUser? @relation("MemorySubject", fields: [subjectUserId], references: [id], onDelete: Restrict)

  guildId String? @map("guild_id")

  confidence Float
  status     MemoryStatus @default(ACTIVE)

  sourceMessageId String?              @map("source_message_id")
  sourceMessage   ConversationMessage? @relation("MemorySource", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastConfirmedAt DateTime? @map("last_confirmed_at")

  evidence MemoryEvidence[]
  audits   MemoryAudit[]

  @@index([scope, subjectUserId, createdAt])
  @@index([scope, guildId, createdAt])
  @@index([sourceMessageId])
  @@map("memories")
}

model MemoryAudit {
  id String @id @default(cuid())

  action MemoryAuditAction

  actorDiscordUserId String      @map("actor_discord_user_id")
  actor              DiscordUser @relation(fields: [actorDiscordUserId], references: [discordUserId], onDelete: Restrict)

  memoryId String? @map("memory_id")
  memory   Memory? @relation(fields: [memoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorDiscordUserId, createdAt])
  @@index([memoryId])
  @@map("memory_audits")
}

model MemoryEvidence {
  id String @id @default(cuid())

  idempotencyKey String @unique @map("idempotency_key")

  memoryId String @map("memory_id")
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  sourceMessageId String              @map("source_message_id")
  sourceMessage   ConversationMessage @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([memoryId])
  @@index([sourceMessageId])
  @@map("memory_evidence")
}
